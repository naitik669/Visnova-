VITE_APP_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VISNOVA_BETA=true
VITE_VISNOVA_BETA_DEBUG=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Analytics (PostHog) — opt-in, consent-gated in app
VITE_ENABLE_ANALYTICS=false

# Core-loop accountability (closed beta: on)
VITE_ENABLE_ACCOUNTABILITY=true
VITE_ENABLE_CIRCLE_MOMENTUM=true
VITE_ENABLE_WEEKLY_SPRINTS=true
VITE_ENABLE_NUDGES=true

# Social surfaces (closed beta: feed/circle on, messages off until RLS QA + report/block basics)
VITE_ENABLE_PUBLIC_FEED=true
VITE_ENABLE_CIRCLE=true
VITE_ENABLE_MESSAGES=false

# Resource goals + growth resources (closed beta: on)
VITE_ENABLE_MONEY=true
VITE_ENABLE_GROWTH_RESOURCES=true

# Collaboration (closed beta: on, realtime sync required)
VITE_ENABLE_VISION_TEAMS=true

# Hidden modules — keep off until explicitly promoted out of closed beta
VITE_ENABLE_STORE=false
VITE_ENABLE_STORE_RECOMMENDATIONS=false
VITE_ENABLE_ASSISTANT=false
VITE_ENABLE_NOVA_CLOCK=false
VITE_ENABLE_MIND_VISUALIZER=false
VITE_ENABLE_SUBSCRIPTIONS=false
VITE_ENABLE_ADVANCED_ANIMATIONS=false

# Beta gate
VITE_ENABLE_BETA_GATE=true

# Android/Supabase redirect allow-list should include:
# https://your-production-domain.com/auth/callback
# visnova://auth/callback
# com.visnova.app://auth/callback

# Server-only Vercel env vars for feedback email delivery.
# Do not prefix these with VITE_ and do not expose them in frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=VisNova <feedback@your-domain.com>
FEEDBACK_TO_EMAIL=naitik.business69@gmail.com
